#!/usr/bin/env bash
set -euo pipefail

# pwd -P is required: ~/.claude/skills/<name> is a symlink, and logical
# ../../../../ from that path is $HOME, not the engine checkout.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ENGINE_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd -P)"
PYTHON="${PYTHON3:-$(command -v python3)}"

if [[ -z "$PYTHON" ]]; then
  echo "change-neighbor: python3 not found on PATH" >&2
  exit 127
fi

exec "$PYTHON" "$ENGINE_ROOT/scripts/change_neighbor.py" "$@"
